<%- include('../../layout/header_em.ejs') %>
<%- include('../../layout/sidebar_pooc.ejs') %>
<div class="body flex-grow-1">
    <div class="container-lg px-4">
        <div class="row mb-2">
            <form class="row g-3" method="post" action="/update_ujipetikpooc/<%= infos._id %>" enctype="multipart/form-data">             
                <div class="col-md-6">
                    <label for="inputTransaksi" class="form-label">Status</label>
                    <select id="inputTransaksi" name="status" class="form-select">
                      <option value="sudah" <%= infos.status === 'sudah' ? 'selected' : '' %>>Sudah</option>
                      <option value="belum" <%= infos.status === 'belum' ? 'selected' : '' %>>Belum</option>
                    </select>
                </div>
                <div class="col-md-6">
                  <label for="inputTransaksi" class="form-label">Jenis Uji Petik</label>
                  <select id="inputTransaksi" name="jenis_ujipetik" class="form-select">
                    <option value="Fisik" <%= infos.jenis_ujipetik === 'Fisik' ? 'selected' : '' %>>Fisik</option>
                    <option value="Non_Fisik" <%= infos.jenis_ujipetik === 'Non_Fisik' ? 'selected' : '' %>>Non Fisik</option>
                  </select>
              </div>
              <div class="mb-3">
                <label for="formFileMultiple" class="form-label">Dokumentasi</label>
                <input class="form-control" type="file" id="dokumentasi" name="dokumentasi" accept=".jpeg,.jpg,.png,.gif,.pdf,.xlsx,.xls,.csv" multiple>
              </div>             
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function formatNumber(value) {
      // Remove non-numeric characters (except for periods and commas)
      const number = value.replace(/[^\d]/g, '');
      // Add thousands separators
      return number.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    document.getElementById('inputZip').addEventListener('input', function(event) {
      const input = event.target;
      const cursorPosition = input.selectionStart;
      const value = input.value;

      // Format the value and update the input
      input.value = formatNumber(value);

      // Restore cursor position after formatting
      input.setSelectionRange(cursorPosition, cursorPosition);
    });

    document.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch('/api/jenis_transaksi');
      const transactions = await response.json();
      const selectElement = document.getElementById('inputState');
      const currentValue = selectElement.getAttribute('data-current-value');

      transactions.forEach(transaction => {
        const optGroup = document.createElement('optgroup');
        optGroup.label = transaction.jenis_transaksi;

        transaction.options.forEach(option => {
          const optionElement = document.createElement('option');
          optionElement.value = option;
          optionElement.textContent = option;

          // Set selected attribute if the option matches the current value
          if (option === currentValue) {
            optionElement.selected = true;
          }

          optGroup.appendChild(optionElement);
        });

        selectElement.appendChild(optGroup);
      });
    } catch (error) {
      console.error('Error fetching transactions:', error);
    }
  });
  
    document.getElementById('inputPhone').addEventListener('input', function(event) {
    let input = event.target;
    let value = input.value;

    // Ensure the value always starts with +62
    if (!value.startsWith('+62')) {
      value = '+62' + value.replace(/[^\d]/g, ''); // Remove non-numeric characters except for the leading +
    } else {
      // Remove leading zeros after +62
      value = '+62' + value.slice(3).replace(/^0+/, '').replace(/[^\d]/g, '');
    }

    // Update the input value
    input.value = value;
  });

  // Prevent deletion of +62
  document.getElementById('inputPhone').addEventListener('keydown', function(event) {
    let input = event.target;
    let value = input.value;

    if (value.startsWith('+62') && input.selectionStart <= 3 && event.key === 'Backspace') {
      event.preventDefault(); // Prevent deleting the +62 prefix
    }
  });
  </script>
<%- include('../../layout/footer.ejs') %>