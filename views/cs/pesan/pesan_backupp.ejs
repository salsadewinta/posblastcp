<%- include('../../layout/header_em.ejs') %>
<%- include('../../layout/sidebar_em.ejs') %>
<div class="body flex-grow-1">
    <div class="container-lg px-4">
        <div class="row mb-2">
            <div class="card mb-4">
                <div class="card-header"><strong>Data Pesan</strong><span class="small ms-1"></span></div>
                <div class="card-body">
                <a href="/em/pesan/create_pesan" type="button" class="btn btn-primary"><span class="cil-plus "></span>Tambah Data</a>
                <div class="example">
                    <ul class="nav nav-underline-border" role="tablist">
                            <li class="nav-item"><a class="nav-link active" data-coreui-toggle="tab" href="#" role="tab">
                            <svg class="icon me-2">
                                <use xlink:href="/@coreui/icons/sprites/free.svg#cil-media-play"></use>
                            </svg>Raw data</a></li>
                            <li class="nav-item"><a class="nav-link" data-coreui-toggle="tab" href="/csv" role="tab">
                                <svg class="icon me-2">
                                    <use xlink:href="/@coreui/icons/sprites/free.svg#cil-scala"></use>
                                </svg>CSV</a></li>
                            <li class="nav-item"><a class="nav-link" href="/excel" target="_blank">
                                <svg class="icon me-2">
                                    <use xlink:href="/@coreui/icons/sprites/free.svg#cil-readme "></use>
                                </svg>Excel</a></li>
                            <li class="nav-item"><a class="nav-link" href="/pdf" target="_blank">
                                <svg class="icon me-2">
                                <use xlink:href="/@coreui/icons/sprites/free.svg#cil-read-the-docs"></use>
                                </svg>PDF</a></li>
                    </ul>
                    <div class="tab-content rounded-bottom">
                    <div class="tab-pane p-3 active preview" role="tabpanel" id="preview-1002">
                        <table class="table table-striped dark">
                            <thead class="table-primary">
                              <tr>
                                <th scope="col">No</th>
                                <th scope="col">Judul</th>
                                <th scope="col">Isi Pesan</th>
                                <th scope="col">Foto</th>
                                <th scope="col">Action</th>
                              </tr>
                            </thead>
                            <tbody class="table-group-divider">
                              <% if(messages.length > 0 ){
                                      for(let i = 0; i <messages.length; i++){
                                           %>
                                  <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= messages[i]['title'] %></td>
                                    <td><%= messages[i]['body'] %></td>
                                    <td>
                                      <% if(messages[i].foto) { %>
                                        <img src="<%= messages[i].foto %>" alt="Foto" style="width:100px;height:auto;">
                                      <% } else { %>
                                        No Image
                                      <% } %>
                                    </td>
                                    <td>
                                      <a href="/updatepesan/<%= messages[i]['id'] %>"  type="button" class="btn btn-warning">Update</a>
                                      <a href="/deletepesan/<%= messages[i]['id'] %>" type="button" class="btn btn-danger">Delete</a>  
                                      </td>
                                    </tr>
                                  </tr>
                                  <%}}%>
                              </tbody>
                            </table>
                    </div>
                    </div>
                </div>

                </div>
            </div>
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-end">
                  <li class="page-item disabled">
                    <a class="page-link">Previous</a>
                  </li>
                  <li class="page-item"><a class="page-link" href="#">1</a></li>
                  <li class="page-item"><a class="page-link" href="#">2</a></li>
                  <li class="page-item"><a class="page-link" href="#">3</a></li>
                  <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                  </li>
                </ul>
            </nav>
        </div>
    </div>
</div>
<%- include('../../layout/footer.ejs') %>