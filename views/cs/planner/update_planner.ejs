<%- include('../../layout/header_em.ejs') %>
<%- include('../../layout/sidebar_em.ejs') %>
<div class="body flex-grow-1">
    <div class="container-lg px-4">
        <div class="row mb-2">
            <form class="row g-3" method="post" action="/update_planner/<%= planner._id %>">
                <div class="col-12">
                    <label for="currentDate" class="form-label">Tanggal Kirim Pesan</label>
                    <div class="row">
                      <div class="col-sm-6 col-lg-5 mb-3 mb-sm-0">
                        <input type="date" id="currentDate" name="tgl_planner" class="form-control" value="<%= planner.tgl_planner %>"> 
                      </div>    
                    </div>
                  </div>
                  <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Tema Pesan</label>
                    <textarea class="form-control" id="tema" rows="4" name="tema"><%= planner.tema %></textarea>
                  </div>          
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../../layout/footer.ejs') %>